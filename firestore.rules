rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'zF3VlnHCltQnsped1wXfmIaMiZo1' ||
        request.auth.token.get('role', '') == 'admin'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function validProfileUpdate() {
      let changedFields = request.resource.data.diff(resource.data).affectedKeys();
      return changedFields.hasOnly(['name', 'avatarUrl', 'updatedAt']) &&
        (
          !changedFields.hasAny(['name']) ||
          (
            request.resource.data.name is string &&
            request.resource.data.name.size() > 0 &&
            request.resource.data.name.size() <= 40
          )
        ) &&
        (
          !changedFields.hasAny(['avatarUrl']) ||
          request.resource.data.avatarUrl is string
        );
    }

    // PERFILES, FAVORITOS E ITINERARIOS
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasOnly([
          'name', 'email', 'avatarUrl', 'role', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.keys().hasAll(['name', 'email', 'role']) &&
        request.resource.data.role == 'user' &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 40 &&
        request.resource.data.email is string;
      allow update: if isOwner(userId) && validProfileUpdate();

      match /favorites/{placeId} {
        allow read, write: if isOwner(userId);
      }

      match /itinerarios/{itineraryId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAdmin();
      }

    }

    // CATÁLOGO DE LUGARES
    match /places/{placeId} {
      allow read: if true;
      allow write: if isAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated() && request.auth.uid == reviewId;
      }
    }

    // EVENTOS
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}